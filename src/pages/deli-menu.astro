---
// Deli Menu and Platters on one page. All items and prices come from src/data/menu.js.
import Base from '../layouts/Base.astro';
import OrderForm from '../components/OrderForm.astro';
import { business, stores } from '../data/site.js';
import { pierogi, sandwiches, entrees, platters } from '../data/menu.js';
import '../styles/menu-page.css';
const ss = stores[0];
const slug = (s) => s.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
// Platters layout: left column, then right column.
const byHeading = Object.fromEntries(platters.map((g) => [g.heading, g]));
const platterCols = [
  ['Cold Cut Platters', 'Cake Platter', 'Bread Tray'],
  ['Party Trays'],
].map((col) => col.map((h) => byHeading[h]).filter(Boolean));
const tabs = [
  ['pierogi', 'Pierogi'], ['sandwiches', 'Sandwiches'], ['entrees', 'Entrees'],
  ...platterCols.flat().map((g) => [slug(g.heading), g.heading]),
  ['order', 'Order online'],
];
---
<Base title="Deli Menu & Platters · Polka Deli" description="Pierogi, sandwiches, Polish entrees and party platters from Polka Deli. Call 301-384-3354 or email your order.">
  <div class="mp">
    <h1 class="mp-title mp-title--photo"><img src="/images/media/printed-menu-2.jpg" alt="Polka Deli printed menu: Menu, always fresh" /></h1>

    <nav class="mp-tabs" aria-label="Menu sections">
      <div class="mp-wrap">
        {tabs.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </div>
    </nav>

    <div class="mp-wrap">
      <section class="mp-group" id="deli">
        <h2 class="mp-group__title">Deli Menu</h2>

        <div class="mp-grid">
          <div class="mp-col">
            <section class="mp-cat" id="pierogi">
              <h3>Pierogi</h3>
              <ul class="mp-items mp-items--split">
                {pierogi.prices.map(([size, price]) => (
                  <li><p class="mp-item"><span>{size}</span><b>{price}</b></p></li>
                ))}
              </ul>
              <p class="mp-pick"><span>Pick one:</span> {pierogi.fillings.join(', ')}</p>
              <p class="mp-note">{pierogi.servedWith}</p>
            </section>
            <section class="mp-cat" id="sandwiches">
              <h3>Sandwiches <span class="mp-badge">{sandwiches.price} each</span></h3>
              <ul class="mp-items">
                {sandwiches.items.map((item) => (
                  <li><p class="mp-item"><span>{item.name}</span></p><p class="mp-desc">{item.desc}</p></li>
                ))}
              </ul>
              <p class="mp-note">{sandwiches.side[0]} <b>{sandwiches.side[1]}</b></p>
            </section>
          </div>
          <div class="mp-col">
            <section class="mp-cat" id="entrees">
              <h3>Entrees</h3>
              <ul class="mp-items">
                {entrees.map((item) => (
                  <li>
                    <p class="mp-item"><span>{item.name}{item.note && <em> {item.note}</em>}</span><b>{item.price}</b></p>
                    {item.desc && <p class="mp-desc">{item.desc}</p>}
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </div>
      </section>

      <section class="mp-group" id="platters">
        <div class="mp-group__head">
          <h2 class="mp-group__title">Platters</h2>
          <p class="mp-email">Order ahead with our <a href="#order">online order form</a></p>
        </div>
        <div class="mp-grid">
          {platterCols.map((col) => (
            <div class="mp-col">
            {col.map((g) => (
            <section class="mp-cat" id={slug(g.heading)}>
              <h3>{g.heading}{g.serves && <span class="mp-badge mp-badge--line">{g.serves}</span>}</h3>
              <ul class="mp-items">
                {g.items.map((item) => (
                  <li>
                    <p class="mp-item"><span>{item.name}</span><b>{item.price}</b></p>
                    {item.desc && <p class="mp-desc">{item.desc}</p>}
                    {item.list && <ul class="mp-list">{item.list.map((l) => <li>{l}</li>)}</ul>}
                  </li>
                ))}
              </ul>
            </section>
            ))}
            </div>
          ))}
        </div>
      </section>

      <OrderForm />
    </div>
  </div>
</Base>

<script>
  // Highlight the tab for the section in view.
  const tabs = [...document.querySelectorAll('.mp-tabs a')];
  const secs = tabs.map((a) => document.querySelector(a.getAttribute('href')));
  const setOn = (k) => tabs.forEach((a, i) => a.classList.toggle('is-on', i === k));
  let lock = 0;
  const onScroll = () => {
    if (Date.now() < lock) return;
    // The section nearest the top wins; side-by-side sections (same top) go to the first one.
    let k = 0, best = -Infinity;
    secs.forEach((s, i) => { const t = Math.round(s.getBoundingClientRect().top); if (t < 220 && t > best) { best = t; k = i; } });
    setOn(k);
  };
  // A clicked tab stays underlined while the page scrolls to it.
  tabs.forEach((a, i) => a.addEventListener('click', () => { setOn(i); lock = Date.now() + 900; }));
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
