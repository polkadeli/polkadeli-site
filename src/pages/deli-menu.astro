---
// Deli Menu and Platters on one page. All items and prices come from src/data/menu.js.
import Base from '../layouts/Base.astro';
import { business, stores } from '../data/site.js';
import { pierogi, sandwiches, entrees, platters } from '../data/menu.js';
import '../styles/menu-page.css';
const ss = stores[0];
const orderMail = `mailto:${business.email}?subject=${encodeURIComponent('Deli Order')}`;
const slug = (s) => s.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
const tabs = [
  ['pierogi', 'Pierogi'], ['sandwiches', 'Sandwiches'], ['entrees', 'Entrees'],
  ...platters.map((g) => [slug(g.heading), g.heading]),
];
---
<Base title="Deli Menu & Platters · Polka Deli" description="Pierogi, sandwiches, Polish entrees and party platters from Polka Deli. Call 301-384-3354 or email your order.">
  <div class="mp">
    <header class="mp-head">
      <div class="mp-wrap">
        <h1>Deli Menu &amp; Platters</h1>
        <p>Please call <a href={ss.phoneHref}>{ss.phone}</a> to order or email your order: <a href={orderMail}>{business.email}</a></p>
      </div>
    </header>

    <nav class="mp-tabs" aria-label="Menu sections">
      <div class="mp-wrap">
        {tabs.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </div>
    </nav>

    <div class="mp-wrap">
      <section class="mp-group" id="deli">
        <h2 class="mp-group__title">Deli Menu</h2>

        <div class="mp-grid">
          <section class="mp-cat" id="pierogi">
            <h3>Pierogi</h3>
            <ul class="mp-sizes">
              {pierogi.prices.map(([size, price]) => <li><span>{size}</span><b>{price}</b></li>)}
            </ul>
            <p class="mp-label">Pick one</p>
            <ul class="mp-chips">{pierogi.fillings.map((f) => <li>{f}</li>)}</ul>
            <p class="mp-note">{pierogi.servedWith}</p>
          </section>

          <section class="mp-cat" id="sandwiches">
            <h3>Sandwiches <span class="mp-badge">{sandwiches.price} each</span></h3>
            <ul class="mp-items">
              {sandwiches.items.map((item) => (
                <li><p class="mp-item"><span>{item.name}</span></p><p class="mp-desc">{item.desc}</p></li>
              ))}
            </ul>
            <p class="mp-note">{sandwiches.side[0]} <b>{sandwiches.side[1]}</b></p>
          </section>

          <section class="mp-cat mp-cat--wide" id="entrees">
            <h3>Entrees</h3>
            <ul class="mp-items mp-items--two">
              {entrees.map((item) => (
                <li>
                  <p class="mp-item"><span>{item.name}{item.note && <em> {item.note}</em>}</span><b>{item.price}</b></p>
                  {item.desc && <p class="mp-desc">{item.desc}</p>}
                </li>
              ))}
            </ul>
          </section>
        </div>
      </section>

      <section class="mp-group" id="platters">
        <h2 class="mp-group__title">Platters</h2>
        <div class="mp-grid">
          {platters.map((g) => (
            <section class="mp-cat" id={slug(g.heading)}>
              <h3>{g.heading}{g.serves && <span class="mp-badge mp-badge--line">{g.serves}</span>}</h3>
              <ul class="mp-items">
                {g.items.map((item) => (
                  <li>
                    <p class="mp-item"><span>{item.name}</span><b>{item.price}</b></p>
                    {item.desc && <p class="mp-desc">{item.desc}</p>}
                    {item.list && <ul class="mp-list">{item.list.map((l) => <li>{l}</li>)}</ul>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>

      <p class="mp-order">Please call <a href={ss.phoneHref}>{ss.phone}</a> to order or email your order: <a href={orderMail}>{business.email}</a></p>
    </div>
  </div>
</Base>

<script>
  // Highlight the tab for the section in view.
  const tabs = [...document.querySelectorAll('.mp-tabs a')];
  const secs = tabs.map((a) => document.querySelector(a.getAttribute('href')));
  const onScroll = () => {
    let k = 0;
    secs.forEach((s, i) => { if (s.getBoundingClientRect().top < 220) k = i; });
    tabs.forEach((a, i) => a.classList.toggle('is-on', i === k));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
