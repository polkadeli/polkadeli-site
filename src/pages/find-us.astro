---
import Base from '../layouts/Base.astro';
import VisitStores from '../components/VisitStores.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { business, stores } from '../data/site.js';
import '../styles/visit.css';
---
<Base title="Visit Us · Polka Deli" description="Polka Deli store hours and directions: Silver Spring, MD (13438 New Hampshire Ave) and Vienna, VA (431 Maple Ave W).">
  <VisitStores />

  <div class="visit-rest">
    <section class="ct" aria-labelledby="contact-title">
      <div class="ct__info">
        <h2 id="contact-title">Suggestions? Contact us</h2>
        <p>For questions about any of our products, or help with placing your order, send us a message using the form, or give us a call.</p>
        <dl class="ct__lines">
          <div><dt>Phone</dt><dd><a href={stores[0].phoneHref}>{stores[0].phone}</a></dd></div>
        </dl>
        <div class="ct__follow">
          <span>Follow us</span>
          <SocialIcons size={22} />
        </div>
      </div>

      <form class="ct__form" name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="company">
        <input type="hidden" name="form-name" value="contact" />
        <p class="contact__trap"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <div class="ct__two">
          <label class="ct__field">Name *<input name="name" type="text" autocomplete="name" required /></label>
          <label class="ct__field">Email *<input name="email" type="email" autocomplete="email" required /></label>
        </div>
        <label class="ct__field">Message<textarea name="message" rows="5"></textarea></label>
        <button class="ct__send" type="submit">Send</button>
      </form>
    </section>
  </div>
</Base>
