---
// Shop ("Polish Groceries"): store-aisle layout. Products come from src/data/groceries.js.
import Base from '../layouts/Base.astro';
import { columns } from '../data/groceries.js';
import '../styles/shop.css';

const groups = columns.flat();
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// Round photo beside each aisle title (swap any of these as better photos come in).
const photoFor = {
  Kielbasa: '/images/shop/kabanosy.jpg',
  Cheese: '/images/media/deli-table.jpg',
  'Deli Meats': '/images/shop/cold-cuts.jpg',
  Pierogi: '/images/media/pierogi-2.jpg',
  Blintzes: '/images/media/paczki.jpg',
  'Marinated Goods': '/images/media/jars.jpg',
  Sweets: '/images/shop/sweets.jpg',
  'Baked Goods': '/images/media/paczki.jpg',
  Other: '/images/media/groceries.jpg',
};
const photo = (t) => photoFor[t] ?? '/images/media/groceries.jpg';
const name = (i) => (typeof i === 'string' ? i : i.name);
const note = (i) => (typeof i === 'string' ? '' : i.note);
---
<Base title="Polish Groceries · Polka Deli" description="Polish groceries at Polka Deli: kielbasa, cheese, deli meats, frozen pierogi and blintzes, jars, sweets and baked goods.">
  <div class="shop">
    <header class="shop__head">
      <h1>Polish Groceries</h1>
      <p>If you don't see a product listed below please ask, we often add products, and can also custom order if a product is available.</p>
    </header>

    <div class="shop__body">
      <nav class="shop__side" aria-label="Grocery categories">
        {groups.map((g) => <a href={`#${slug(g.title)}`}>{g.title}</a>)}
      </nav>

      <div>
        {groups.map((g) => (
          <section class="aisle" id={slug(g.title)} aria-labelledby={`h-${slug(g.title)}`}>
            <div class="aisle__body">
              <h2 class="aisle__title" id={`h-${slug(g.title)}`}><img class="aisle__dot" src={photo(g.title)} alt="" loading="lazy" />{g.title}{g.tag && <span> {g.tag}</span>}</h2>
              <ul class="aisle__list">
                {g.items.map((i) => <li>{name(i)}{note(i) && <em> {note(i)}</em>}</li>)}
              </ul>
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>

<script>
  // Highlight the category in view.
  const links = [...document.querySelectorAll('.shop__side a')];
  const secs = links.map((a) => document.querySelector(a.getAttribute('href')));
  let lock = 0;
  const setOn = (k) => links.forEach((a, i) => a.classList.toggle('is-on', i === k));
  const onScroll = () => {
    if (Date.now() < lock) return;
    let k = 0;
    secs.forEach((s, i) => { if (s.getBoundingClientRect().top < 200) k = i; });
    setOn(k);
  };
  links.forEach((a, i) => a.addEventListener('click', () => { setOn(i); lock = Date.now() + 900; }));
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
