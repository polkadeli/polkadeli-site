---
import Base from '../layouts/Base.astro';
import PageCard from '../components/PageCard.astro';
import { business, stores } from '../data/site.js';
import { columns, photos } from '../data/groceries.js';
import '../styles/page.css';
import '../styles/shop.css';
const ss = stores[0];
const orderMail = `mailto:${business.email}?subject=${encodeURIComponent('Groceries Order')}`;
---
<Base title="Groceries · Polka Deli" description="Polish groceries at Polka Deli: kielbasa, cheese, deli meats, frozen pierogi and blintzes, jars, sweets and baked goods.">
  <PageCard title="Groceries" background="/images/bg-wood.jpg" wide>
    <p class="page-card__intro">If you don't see a product listed below please ask, we often add products, and can also custom order.<br />
      Please call <a href={ss.phoneHref}>{ss.phone}</a> to order or email your order: <a href={orderMail}>{business.email}</a></p>

    <div class="groceries">
      {columns.map((col) => (
        <div class="groceries__column">
          {col.map((group) => (
            <section class="groceries__group">
              <h2 class="groceries__title">{group.title}{group.tag && <span class="groceries__tag"> {group.tag}</span>}</h2>
              <ul class="groceries__list">
                {group.items.map((item) => typeof item === 'string'
                  ? <li>{item}</li>
                  : <li>{item.name}<span class="groceries__note">{item.note}</span></li>)}
              </ul>
            </section>
          ))}
        </div>
      ))}
    </div>

    <ul class="photo-grid">
      {photos.map((p) => <li><img src={p.src} alt={p.alt} loading="lazy" width="800" height="600" /></li>)}
    </ul>
  </PageCard>
</Base>
