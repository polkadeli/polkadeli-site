---
import Base from '../layouts/Base.astro';
import PageCard from '../components/PageCard.astro';
import { business, stores } from '../data/site.js';
import { platters } from '../data/menu.js';
import '../styles/page.css';
import '../styles/menu.css';
const ss = stores[0];
const orderMail = `mailto:${business.email}?subject=${encodeURIComponent('Platter Order')}`;
// Two columns: Cold Cut Platters + Bread Tray | Party Trays + Cake Platter
const columns = [platters.slice(0, 2), platters.slice(2)];
---
<Base title="Platters · Polka Deli" description="Polish cold cut, cheese and kielbasa platters, party trays and cake platters from Polka Deli. Call 301-384-3354 or email your order.">
  <PageCard title="Platters" background="/images/bg-pierogi.jpg" wide>
    <p class="page-card__intro">Please call <a href={ss.phoneHref}>{ss.phone}</a> to order or email your order: <a href={orderMail}>{business.email}</a></p>

    <div class="menu menu--two">
      {columns.map((groups) => (
        <div class="menu__column">
          {groups.map((g) => (
            <section class="menu__group">
              <h2 class="menu__heading">{g.heading}</h2>
              {g.serves && <p class="menu__note">{g.serves}</p>}
              <ul class="menu__items">
                {g.items.map((item) => (
                  <li class="menu__item">
                    <p class="menu__item-head"><span class="menu__item-name">{item.name}</span><span class="menu__leader" aria-hidden="true"></span><span class="menu__price">{item.price}</span></p>
                    {item.desc && <p class="menu__desc">{item.desc}</p>}
                    {item.list && <ul class="menu__choices">{item.list.map((l) => <li>{l}</li>)}</ul>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ))}
    </div>
  </PageCard>
</Base>
