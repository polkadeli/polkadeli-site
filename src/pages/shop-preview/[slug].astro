---
import StoreLayout from '../../layouts/StoreLayout.astro';
import ProductCard from '../../components/store/ProductCard.astro';
import ProductImage from '../../components/store/ProductImage.astro';
import { products, catBySlug, money, fulfillment } from '../../data/shop-sample.js';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product: x } = Astro.props;
const cat = catBySlug[x.category];
const related = products.filter((r) => r.category === x.category && r.slug !== x.slug).slice(0, 4);
const start = x.variants.findIndex((v) => v[0] === '1 lb');
const first = start >= 0 ? start : 0;
---
<StoreLayout title={`${x.name} (preview) · Polka Deli`} description={x.desc} active={x.category}>
  <div class="store-section">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/shop-preview">Shop</a><span aria-hidden="true">/</span><a href={`/shop-preview?c=${cat.slug}`}>{cat.name}</a><span aria-hidden="true">/</span><span aria-current="page">{x.name}</span>
    </nav>

    <div class="pdp">
      <div class="pdp__media">
        <ProductImage image={x.image} name={x.name} />
        {x.badge && <span class="product-card__badge">{x.badge}</span>}
      </div>

      <form class="pdp__info" data-product-form onsubmit="return false">
        <p class="product-card__cat">{cat.name}</p>
        <h1 class="pdp__title">{x.name}</h1>
        <p class="pdp__price" data-price>{money(x.variants[first][1])}</p>
        {x.size && <p class="pdp__size">{x.size}</p>}

        {x.variants.length > 1 && (
          <fieldset class="variants">
            <legend>{x.weighed ? 'Amount' : 'Option'}</legend>
            {x.variants.map(([label, price], i) => (
              <label class="variant"><input type="radio" name="variant" value={i} data-price-value={money(price)} checked={i === first} /><span>{label}</span></label>
            ))}
          </fieldset>
        )}
        {x.variants.length === 1 && <input type="radio" name="variant" value="0" checked hidden />}

        {x.weighed && (
          <fieldset class="variants">
            <legend>Slicing</legend>
            <label class="variant"><input type="radio" name="slice" checked /><span>Thin slices</span></label>
            <label class="variant"><input type="radio" name="slice" /><span>Thick slices</span></label>
            <label class="variant"><input type="radio" name="slice" /><span>One piece</span></label>
          </fieldset>
        )}

        <div class="pdp__buy">
          <div class="qty" aria-label="Quantity">
            <button type="button" data-step="-1" aria-label="Fewer">−</button>
            <span data-qty-value>1</span>
            <button type="button" data-step="1" aria-label="More">+</button>
          </div>
          <button class="btn btn--red btn--grow" type="button" data-add={x.slug}>Add to cart</button>
        </div>

        {x.weighed && <p class="pdp__note">Cut to order at the deli counter. Weights can vary a little; you pay for the actual weight.</p>}

        <div class="pickup">
          <p class="pickup__title">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="m5 12 4 4 10-10"/></svg>
            Pickup available at Silver Spring and Vienna
          </p>
          <ul>{fulfillment.map((f) => <li><strong>{f.label}</strong> {f.note}</li>)}</ul>
        </div>

        <div class="pdp__desc">
          <h2>About this product</h2>
          <p>{x.desc}</p>
        </div>
      </form>
    </div>
  </div>

  {related.length > 0 && (
    <section class="store-section" aria-labelledby="h-related">
      <h2 class="store-heading" id="h-related">More {cat.name.toLowerCase()}</h2>
      <ul class="product-grid">{related.map((r) => <ProductCard product={r} />)}</ul>
    </section>
  )}

  <script>
    const form = document.querySelector('[data-product-form]');
    const qty = form.querySelector('[data-qty-value]');
    form.addEventListener('click', (e) => {
      const b = e.target.closest('[data-step]');
      if (b) qty.textContent = String(Math.max(1, Number(qty.textContent) + Number(b.dataset.step)));
    });
    form.addEventListener('change', (e) => {
      if (e.target.name === 'variant') form.querySelector('[data-price]').textContent = e.target.dataset.priceValue;
    });
  </script>
</StoreLayout>
