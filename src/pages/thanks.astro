---
import Base from '../layouts/Base.astro';
import PageCard from '../components/PageCard.astro';
import '../styles/page.css';
---
<Base title="Thank you · Polka Deli" description="Thanks for getting in touch with Polka Deli.">
  <PageCard title="Thank You" background="/images/bg-pierogi.jpg">
    <p class="page-card__intro thanks-msg" data-default>Thanks! We got your message and will be in touch soon.<br /><a href="/">Back to the homepage</a></p>
    <p class="page-card__intro thanks-msg" data-order hidden>Thank you for your order! We'll email you to confirm it before your pickup time.<br /><a href="/deli-menu">Back to the menu</a></p>
    <script>
      if (new URLSearchParams(location.search).has('order')) {
        document.querySelector('[data-default]').hidden = true;
        document.querySelector('[data-order]').hidden = false;
      }
    </script>
  </PageCard>
</Base>
