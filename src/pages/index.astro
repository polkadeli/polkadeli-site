---
import Base from '../layouts/Base.astro';
import { business, stores } from '../data/site.js';
import '../styles/home.css';
const slides = [
  { src: '/images/slide-pierogi.jpg', alt: 'Pierogi being made on a floured wooden board' },
  { src: '/images/slide-bread.jpg', alt: 'Fresh bread with wheat' },
  { src: '/images/slide-kielbasa.jpg', alt: 'Grilled kielbasa with cabbage and potatoes' },
  { src: '/images/slide-makowiec.jpg', alt: 'Poppy seed roll' },
  { src: '/images/slide-market.jpg', alt: 'Polish market stall with sausages and baked goods' },
];
---
<Base>
  <section class="hero" aria-label="Welcome to Polka Deli">
    <div class="hero__slides" aria-hidden="true">
      {slides.map((s, i) => <img src={s.src} alt="" class={i === 0 ? 'hero__slide is-active' : 'hero__slide'} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />)}
    </div>

    <div class="hero__stage">
      <div class="intro-card">
        <h1 class="intro-card__logo"><img src="/logo.svg" alt="Polka Deli, Polish Food & Market" width="520" height="176" /></h1>

        <div class="trio">
          <div class="trio__cell trio__drawing"><img src="/images/pierogi-drawing.png" alt="" width="150" height="150" /></div>
          <p class="trio__cell trio__tagline">{business.tagline}</p>
          <a class="trio__cell trio__menu" href="/deli-menu">Deli Menu</a>
        </div>

        <a class="pill pill--grey" href={business.uberEats} target="_blank" rel="noopener">Order now with UberEats!</a>

        <ul class="store-lines">
          {stores.map((s) => (
            <li><a href={s.maps}>{s.street}<span class="store-lines__comma">,</span> <span class="store-lines__city">{s.locality}</span></a> <span class="store-lines__sep">|</span> <a href={s.phoneHref}>{s.phone}</a></li>
          ))}
        </ul>
      </div>

      <p class="shipping-banner">International parcel shipping service available at our stores</p>

      <form class="postcard" name="newsletter" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="company">
        <svg class="postcard__mark" viewBox="0 0 120 50" aria-hidden="true">
          <circle cx="24" cy="25" r="20" fill="none" stroke="#bbb" stroke-width="2.5" />
          <circle cx="24" cy="25" r="13" fill="none" stroke="#bbb" stroke-width="2" />
          <path d="M50 14c8-5 14 5 22 0s14 5 22 0 14 5 22 0M50 25c8-5 14 5 22 0s14 5 22 0 14 5 22 0M50 36c8-5 14 5 22 0s14 5 22 0 14 5 22 0" fill="none" stroke="#bbb" stroke-width="2.5" />
        </svg>
        <h2 class="postcard__title">Join our mailing list to receive special offers</h2>
        <p class="postcard__trap"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <div class="postcard__fields">
          <label><span class="visually-hidden">Name</span><input name="name" type="text" required autocomplete="name" placeholder="Name" /></label>
          <label><span class="visually-hidden">Email address</span><input name="email" type="email" required autocomplete="email" placeholder="Email Address" /></label>
          <button class="pill pill--red" type="submit">Subscribe Now</button>
        </div>
        <p class="postcard__privacy">We'll only email you news and offers, and we'll never sell your information. Unsubscribe anytime. <a href="/privacy">Privacy policy</a></p>
      </form>

      <div class="dots" role="group" aria-label="Choose background photo">
        {slides.map((s, i) => <button type="button" aria-label={`Show photo ${i + 1}: ${s.alt}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>)}
      </div>
    </div>
  </section>
</Base>

<script>
  const slides = [...document.querySelectorAll('.hero__slide')];
  const dots = [...document.querySelectorAll('.dots button')];
  let i = 0;
  let timer;
  const show = (n) => {
    slides[i].classList.remove('is-active'); dots[i].setAttribute('aria-pressed', 'false');
    i = (n + slides.length) % slides.length;
    slides[i].classList.add('is-active'); dots[i].setAttribute('aria-pressed', 'true');
  };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = () => { if (!reduce) { clearInterval(timer); timer = setInterval(() => show(i + 1), 5000); } };
  dots.forEach((d, n) => d.addEventListener('click', () => { show(n); start(); }));
  document.addEventListener('visibilitychange', () => (document.hidden ? clearInterval(timer) : start()));
  start();
</script>

