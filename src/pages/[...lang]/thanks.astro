---
import { langOf, langPaths, href, tr, ui } from '../../i18n.js';
export const getStaticPaths = langPaths;
import Base from '../../layouts/Base.astro';
import PageCard from '../../components/PageCard.astro';
import '../../styles/page.css';
const lang = langOf(Astro.url);
const t = ui[lang];
---
<Base title={t.thanksTitle} description={t.thanksDesc} noindex>
  <PageCard title={t.thankYou} background="/images/bg-pierogi.jpg">
    <p class="page-card__intro thanks-msg" data-default>{t.thanksMsg}<br /><a href={href('/', lang)}>{t.backHome}</a></p>
    <p class="page-card__intro thanks-msg" data-order="1" hidden>{t.thanksOrder}<br /><a href={href('/deli-menu', lang)}>{t.backMenu}</a></p>
    <p class="page-card__intro thanks-msg" data-order="paid" hidden>{t.thanksPaid}<br /><a href={href('/deli-menu', lang)}>{t.backMenu}</a></p>
    <p class="page-card__intro thanks-msg" data-order="test" hidden>{t.thanksTest}<br /><a href={href('/deli-menu', lang)}>{t.backMenu}</a></p>
    <script>
      // ?order=paid after Clover payment, ?order=test in test mode, ?order=1 from the old form
      const kind = new URLSearchParams(location.search).get('order');
      const msg = kind && document.querySelector(`[data-order="${kind}"]`);
      if (msg) {
        // Order placed: forget the saved order form
        try { sessionStorage.removeItem('polkadeli-order-deli'); sessionStorage.removeItem('polkadeli-order-platters'); } catch {}
        document.querySelector('[data-default]').hidden = true;
        msg.hidden = false;
      }
    </script>
  </PageCard>
</Base>
