---
import { langOf, langPaths, href, tr, ui } from '../../i18n.js';
export const getStaticPaths = langPaths;
import Base from '../../layouts/Base.astro';
import PageCard from '../../components/PageCard.astro';
import '../../styles/page.css';
const lang = langOf(Astro.url);
const t = ui[lang];
---
<Base title={t.thanksTitle} description={t.thanksDesc}>
  <PageCard title={t.thankYou} background="/images/bg-pierogi.jpg">
    <p class="page-card__intro thanks-msg" data-default>{t.thanksMsg}<br /><a href={href('/', lang)}>{t.backHome}</a></p>
    <p class="page-card__intro thanks-msg" data-order hidden>{t.thanksOrder}<br /><a href={href('/deli-menu', lang)}>{t.backMenu}</a></p>
    <script>
      if (new URLSearchParams(location.search).has('order')) {
        document.querySelector('[data-default]').hidden = true;
        document.querySelector('[data-order]').hidden = false;
      }
    </script>
  </PageCard>
</Base>
