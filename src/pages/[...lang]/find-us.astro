---
// About us: Maria and Joanna's story on top, then a compact card per store (address, hours, call button). One section, no market photo (KK 2026-11-07).
import { langOf, langPaths, ui } from '../../i18n.js';
export const getStaticPaths = langPaths;
import Base from '../../layouts/Base.astro';
import VisitStores from '../../components/VisitStores.astro';
import AboutUs from '../../components/AboutUs.astro';
import '../../styles/visit.css';
const lang = langOf(Astro.url);
const t = ui[lang];
---
<Base title={t.visitTitle} description={t.visitDesc}>
  <section class="visit">
    <div class="visit__wrap">
      <h1 class="visually-hidden">{t.visitUs}</h1>
      <AboutUs />
      <VisitStores />
    </div>
  </section>
</Base>
