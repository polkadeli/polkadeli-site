---
// Deli Menu and Platters on one page. All items and prices come from src/data/menu.js.
import { langOf, langPaths, href, tr, ui } from '../../i18n.js';
export const getStaticPaths = langPaths;
import Base from '../../layouts/Base.astro';
import { business, stores } from '../../data/site.js';
import { pierogi, sandwiches, entrees, platters } from '../../data/menu.js';
import '../../styles/menu-page.css';
const lang = langOf(Astro.url);
const t = ui[lang];
const ss = stores[0];
const slug = (s) => s.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
// Platters as a 2x2 grid so each row lines up: Cold Cuts | Party Trays, then Cake | Bread.
const byHeading = Object.fromEntries(platters.map((g) => [g.heading, g]));
const platterGrid = ['Cold Cut Platters', 'Party Trays', 'Cake Platter', 'Bread Tray'].map((h) => byHeading[h]).filter(Boolean);
const platterTabs = ['Cold Cut Platters', 'Cake Platter', 'Party Trays', 'Bread Tray'].map((h) => byHeading[h]).filter(Boolean);
const tabs = [
  ['pierogi', 'Pierogi'], ['sandwiches', tr(lang, 'Sandwiches')], ['entrees', tr(lang, 'Entrees')],
  ...platterTabs.map((g) => [slug(g.heading), tr(lang, g.heading)]),
];
---
<Base title={t.menuTitle} description={t.menuDesc}>
  <div class="mp">
    <h1 class="mp-title mp-title--photo"><img src="/images/media/printed-menu-2.jpg" alt={t.menuAlt} /></h1>

    <nav class="mp-tabs" aria-label={t.menuSections}>
      <div class="mp-wrap">
        <div class="mp-tabs__links">{tabs.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</div>
        <a class="mp-order" href={href('/order', lang)}>{t.orderPickup}</a>
      </div>
    </nav>

    <div class="mp-wrap">
      <section class="mp-group" id="deli">
        <h2 class="mp-group__title">{t.deliMenu}</h2>

        <div class="mp-grid">
          <div class="mp-col">
            <section class="mp-cat" id="pierogi">
              <h3>Pierogi</h3>
              <ul class="mp-items mp-items--split">
                {pierogi.prices.map(([size, price]) => (
                  <li><p class="mp-item"><span>{tr(lang, size)}</span><b>{price}</b></p></li>
                ))}
              </ul>
              <p class="mp-pick"><span>{t.pickOne}</span> {pierogi.fillings.map((f) => tr(lang, f)).join(', ')}</p>
              <p class="mp-note">{tr(lang, pierogi.servedWith)}</p>
            </section>
            <section class="mp-cat" id="sandwiches">
              <h3>{tr(lang, 'Sandwiches')} <span class="mp-badge">{sandwiches.price} {t.each}</span></h3>
              <ul class="mp-items">
                {sandwiches.items.map((item) => (
                  <li><p class="mp-item"><span>{tr(lang, item.name)}</span></p><p class="mp-desc">{tr(lang, item.desc)}</p></li>
                ))}
              </ul>
              <p class="mp-note">{tr(lang, sandwiches.side[0])} <b>{sandwiches.side[1]}</b></p>
            </section>
          </div>
          <div class="mp-col">
            <section class="mp-cat" id="entrees">
              <h3>{tr(lang, 'Entrees')}</h3>
              <ul class="mp-items">
                {entrees.map((item) => (
                  <li>
                    <p class="mp-item"><span>{tr(lang, item.name)}{item.note && <em> {tr(lang, item.note)}</em>}</span><b>{item.price}</b></p>
                    {item.desc && <p class="mp-desc">{tr(lang, item.desc)}</p>}
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </div>
      </section>

      <section class="mp-group" id="platters">
        <div class="mp-group__head">
          <h2 class="mp-group__title">{t.platters}</h2>
          <p class="mp-email">{t.orderAhead} <a href={href('/order', lang) + '?type=platters'}>{t.orderFormLink}</a> <span>({t.pickupSS})</span></p>
        </div>
        <div class="mp-grid">
          {platterGrid.map((g) => (
            <section class="mp-cat" id={slug(g.heading)}>
              <h3>{tr(lang, g.heading)}{g.serves && <span class="mp-badge mp-badge--line">{tr(lang, g.serves)}</span>}</h3>
              <ul class="mp-items">
                {g.items.map((item) => (
                  <li>
                    <p class="mp-item"><span>{tr(lang, item.name)}</span><b>{item.price}</b></p>
                    {item.desc && <p class="mp-desc">{tr(lang, item.desc)}</p>}
                    {item.list && <ul class="mp-list">{item.list.map((l) => <li>{tr(lang, l)}</li>)}</ul>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>

    </div>
    <!-- Phone: order button stays at the bottom of the screen -->
    <a class="mp-order-bar" href={href('/order', lang)}>{t.orderPickup}</a>
  </div>
</Base>

<script>
  // Highlight the tab for the section in view.
  const tabs = [...document.querySelectorAll('.mp-tabs a:not(.mp-order)')];
  const secs = tabs.map((a) => document.querySelector(a.getAttribute('href')));
  const setOn = (k) => tabs.forEach((a, i) => a.classList.toggle('is-on', i === k));
  let lock = 0;
  const onScroll = () => {
    if (Date.now() < lock) return;
    // The section nearest the top wins; side-by-side sections (same top) go to the first one.
    let k = 0, best = -Infinity;
    secs.forEach((s, i) => { const t = Math.round(s.getBoundingClientRect().top); if (t < 220 && t > best) { best = t; k = i; } });
    setOn(k);
  };
  // A clicked tab stays underlined while the page scrolls to it.
  tabs.forEach((a, i) => a.addEventListener('click', () => { setOn(i); lock = Date.now() + 900; }));
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
