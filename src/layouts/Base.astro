---
import { business, stores, nav } from '../data/site.js';
const {
  title = 'Polka Deli · Polish Food & Market in Silver Spring, MD and Vienna, VA',
  description = 'Authentic Polish groceries and food prepared daily. Kielbasa, deli meats, pierogi, cheese, sweets and party platters in Silver Spring, MD and Vienna, VA.',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const jsonLd = stores.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'GroceryStore',
  name: `Polka Deli ${s.city}`,
  url: 'https://www.polkadelimd.com',
  telephone: s.phone,
  address: { '@type': 'PostalAddress', streetAddress: s.street, addressLocality: s.locality.split(',')[0], addressRegion: s.locality.split(', ')[1].split(' ')[0], postalCode: s.locality.split(' ').pop(), addressCountry: 'US' },
  sameAs: [business.facebook],
}));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400&family=Fredericka+the+Great&family=Roboto+Condensed:wght@400;500;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topnav">
    <nav aria-label="Main">
      <ul class="links">
        {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <a class="fb" href={business.facebook} target="_blank" rel="noopener" aria-label="Polka Deli on Facebook">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>
      </a>
    </nav>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span><span></span>
    </button>
  </header>
  <div class="drawer" id="drawer" hidden>
    <button class="drawer-close" type="button" aria-label="Close menu">×</button>
    <ul>
      {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
  </div>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="footer-inner">
      {stores.map((s) => (
        <div class="footer-store">
          <h2>{s.city}</h2>
          <p><a href={s.maps}>{s.street}<br />{s.locality}</a></p>
          <p><a href={s.phoneHref}>{s.phone}</a></p>
          <ul>{s.hours.map(([d, h]) => <li><span>{d}</span>{h}</li>)}</ul>
        </div>
      ))}
      <div class="footer-store">
        <h2>Order</h2>
        <p>Call your store or email<br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
        <p><a href={business.uberEats} target="_blank" rel="noopener">Order on Uber Eats</a></p>
        <p><a href={business.facebook} target="_blank" rel="noopener">Like us on Facebook</a></p>
      </div>
    </div>
    <p class="copy">© {new Date().getFullYear()} Polka Deli · Polish Food &amp; Market</p>
  </footer>

  <script>
    const burger = document.querySelector('.burger');
    const drawer = document.getElementById('drawer');
    const close = document.querySelector('.drawer-close');
    const setOpen = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      if (open) { drawer.hidden = false; requestAnimationFrame(() => drawer.classList.add('open')); close.focus(); }
      else { drawer.classList.remove('open'); setTimeout(() => (drawer.hidden = true), 250); burger.focus(); }
    };
    burger.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) setOpen(false); });
  </script>
</body>
</html>

<style is:global>
  :root {
    --red: #c82023;
    --red-bright: #e21c21;
    --red-hover: #950b0b;
    --red-heading: #8b0000;
    --ink: #111;
    --grey: #4d4d4d;
    --muted: #666;
    --card: rgba(255, 255, 255, 0.93);
    --cond: 'Roboto Condensed', 'Arial Narrow', sans-serif;
    --nav: 'Barlow', 'Helvetica Neue', sans-serif;
    --wood: 'Fredericka the Great', Georgia, serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: var(--cond); font-size: 18px; line-height: 1.5; color: var(--ink); background: #fff; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 12px; top: 12px; z-index: 50; background: #fff; padding: 8px 12px; }

  /* Sticky white top nav with thin vertical rules, like the current site */
  .topnav { position: sticky; top: 0; z-index: 20; background: #fff; box-shadow: 0 1px 0 rgba(0,0,0,.08); }
  .topnav nav { display: flex; justify-content: center; align-items: center; gap: 18px; height: 56px; }
  .links { display: flex; list-style: none; margin: 0; padding: 0; }
  .links li + li { border-left: 1px solid #222; }
  .links a { display: block; padding: 4px 34px; font-family: var(--nav); font-weight: 300; font-size: 18px; color: var(--grey); text-decoration: none; letter-spacing: .02em; transition: color .15s; }
  .links a:hover, .links a:focus-visible { color: var(--red-bright); }
  .links a[aria-current='page'] { color: var(--red); }
  .fb { color: #111; display: flex; padding: 6px; }
  .fb:hover { color: var(--red-bright); }
  .burger { display: none; }

  /* Mobile: black square button and black slide-in panel */
  .drawer { position: fixed; inset: 0 auto 0 0; width: min(78vw, 320px); background: #000; z-index: 40; padding: 80px 32px; transform: translateX(-100%); transition: transform .25s ease; box-shadow: 0 0 0 100vmax rgba(0,0,0,0); }
  .drawer.open { transform: none; box-shadow: 0 0 0 100vmax rgba(0,0,0,.45); }
  .drawer ul { list-style: none; margin: 0; padding: 0; }
  .drawer a { display: block; padding: 14px 0; color: #fff; text-decoration: none; font-family: var(--nav); font-size: 20px; letter-spacing: .18em; text-transform: uppercase; }
  .drawer a[aria-current='page'] { color: var(--red-bright); }
  .drawer-close { position: absolute; top: 14px; right: 14px; width: 44px; height: 44px; background: #000; color: #fff; border: 1px solid #333; font-size: 30px; line-height: 1; cursor: pointer; }
  @media (max-width: 900px) {
    .topnav { position: fixed; top: 12px; right: 12px; left: auto; background: none; box-shadow: none; }
    .topnav nav { display: none; }
    .burger { display: grid; gap: 5px; align-content: center; justify-items: center; width: 48px; height: 48px; background: #000; border: 0; cursor: pointer; }
    .burger span { display: block; width: 24px; height: 2px; background: #fff; }
  }

  /* Footer: new, the current site has none */
  .footer { background: #1d1c1c; color: #eee; padding: 48px 20px 24px; }
  .footer-inner { max-width: 1040px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .footer h2 { font-size: 15px; letter-spacing: .2em; text-transform: uppercase; color: #fff; margin: 0 0 12px; font-weight: 700; border-bottom: 2px solid var(--red); padding-bottom: 8px; display: inline-block; }
  .footer p { margin: 0 0 10px; color: #ddd; }
  .footer a { color: #fff; }
  .footer a:hover { color: #ff8a8c; }
  .footer ul { list-style: none; padding: 0; margin: 0; color: #ccc; font-size: 16px; }
  .footer li span { display: inline-block; width: 82px; color: #aaa; }
  .footer .copy { max-width: 1040px; margin: 32px auto 0; padding-top: 16px; border-top: 1px solid #3a3838; font-size: 14px; color: #999; }
  @media (max-width: 760px) { .footer-inner { grid-template-columns: 1fr; } }
</style>
