---
import { business, stores, nav } from '../data/site.js';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/footer.css';
const {
  title = 'Polka Deli · Polish Food & Market in Silver Spring, MD and Vienna, VA',
  description = 'Authentic Polish groceries and food prepared daily. Kielbasa, deli meats, pierogi, cheese, sweets and party platters in Silver Spring, MD and Vienna, VA.',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const jsonLd = stores.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'GroceryStore',
  name: `Polka Deli ${s.city}`,
  url: 'https://www.polkadelimd.com',
  telephone: s.phone,
  address: { '@type': 'PostalAddress', streetAddress: s.street, addressLocality: s.locality.split(',')[0], addressRegion: s.locality.split(', ')[1].split(' ')[0], postalCode: s.locality.split(' ').pop(), addressCountry: 'US' },
  sameAs: [business.facebook],
}));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400&family=Fredericka+the+Great&family=Roboto+Condensed:wght@400;500;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__links">
        {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <a class="social-link" href={business.facebook} target="_blank" rel="noopener" aria-label="Polka Deli on Facebook">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>
      </a>
      <a class="social-link" href={business.instagram} target="_blank" rel="noopener" aria-label="Polka Deli on Instagram">
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path fill="currentColor" d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.9a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2zM17.1 5.8a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM21.9 8c-.1-1.6-.4-3-1.6-4.2S17.6 2.2 16 2.1C14.3 2 9.7 2 8 2.1c-1.6.1-3 .4-4.2 1.6S2.2 6.4 2.1 8C2 9.7 2 14.3 2.1 16c.1 1.6.4 3 1.6 4.2s2.6 1.5 4.2 1.6c1.7.1 6.3.1 8 0 1.6-.1 3-.4 4.2-1.6s1.5-2.6 1.6-4.2c.1-1.7.1-6.3 0-8zm-2.2 9.9a3.2 3.2 0 0 1-1.8 1.8c-1.3.5-4.3.4-5.7.4s-4.4.1-5.7-.4a3.2 3.2 0 0 1-1.8-1.8c-.5-1.3-.4-4.3-.4-5.7s-.1-4.4.4-5.7a3.2 3.2 0 0 1 1.8-1.8c1.3-.5 4.3-.4 5.7-.4s4.4-.1 5.7.4a3.2 3.2 0 0 1 1.8 1.8c.5 1.3.4 4.3.4 5.7s.1 4.4-.4 5.7z"/></svg>
      </a>
    </nav>
    <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span><span></span>
    </button>
  </header>
  <div class="drawer" id="drawer" hidden>
    <button class="drawer__close" type="button" aria-label="Close menu">×</button>
    <ul class="drawer__links">
      {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
    <p class="drawer__social"><a href={business.facebook} target="_blank" rel="noopener">Facebook</a> · <a href={business.instagram} target="_blank" rel="noopener">Instagram</a></p>
  </div>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="footer-brand">
      <a href="/" aria-label="Polka Deli home"><img src="/logo-white.svg" alt="Polka Deli, Polish Food & Market" width="240" height="81" /></a>
      <p>{business.tagline}</p>
    </div>
    <div class="footer-columns">
      {stores.map((s) => (
        <div class="footer-column">
          <h2>{s.city}</h2>
          <p><a href={s.maps}>{s.street}<br />{s.locality}</a></p>
          <p><a href={s.phoneHref}>{s.phone}</a></p>
          <ul class="footer-hours">{s.hours.map(([d, h]) => <li><span>{d}</span>{h}</li>)}</ul>
        </div>
      ))}
      <div class="footer-column">
        <h2>Order</h2>
        <p>Call your store or email<br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
        <p><a href={business.uberEats} target="_blank" rel="noopener">Order on Uber Eats</a></p>
        <p><a href={business.facebook} target="_blank" rel="noopener">Like us on Facebook</a></p>
        <p><a href={business.instagram} target="_blank" rel="noopener">Follow us on Instagram</a></p>
      </div>
    </div>
    <p class="footer-copy">© {new Date().getFullYear()} Polka Deli · Polish Food &amp; Market</p>
  </footer>

  <script>
    const burger = document.querySelector('.menu-button');
    const drawer = document.getElementById('drawer');
    const close = document.querySelector('.drawer__close');
    const setOpen = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      if (open) { drawer.hidden = false; requestAnimationFrame(() => drawer.classList.add('is-open')); close.focus(); }
      else { drawer.classList.remove('is-open'); setTimeout(() => (drawer.hidden = true), 250); burger.focus(); }
    };
    burger.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) setOpen(false); });
  </script>
</body>
</html>

