---
import { business } from '../data/site.js';
const { title = 'Polka Deli · Polish Food & Market in Silver Spring, MD', description = 'Authentic Polish groceries and food prepared daily in Silver Spring, Maryland. Kielbasa, deli meats, pierogi, cheese, sweets and catering platters.' } = Astro.props;
const nav = [
  { href: '/products', label: 'Products' },
  { href: '/deli-menu', label: 'Deli menu' },
  { href: '/platters', label: 'Platters' },
  { href: '/about', label: 'About' },
  { href: '/find-us', label: 'Visit us' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GroceryStore',
  name: business.name,
  description,
  url: 'https://www.polkadelimd.com',
  telephone: '+1-301-384-3354',
  address: { '@type': 'PostalAddress', streetAddress: business.address, addressLocality: 'Silver Spring', addressRegion: 'MD', postalCode: '20904', addressCountry: 'US' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '11:00', closes: '18:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '11:00', closes: '15:00' },
  ],
  sameAs: [business.facebook],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand" aria-label="Polka Deli home"><img src="/logo.svg" alt="Polka Deli, Polish Food & Market" width="190" height="64" /></a>
      <nav aria-label="Main">
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
      <a class="btn btn-small call" href={business.phoneHref}>Call {business.phone}</a>
      <details class="mnav">
        <summary aria-label="Open menu">Menu</summary>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href={business.phoneHref}>Call {business.phone}</a></li></ul>
      </details>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <img src="/logo.svg" alt="Polka Deli" width="170" height="58" class="footer-logo" />
        <p>Authentic Polish groceries and food prepared daily, run by Maria and Joanna.</p>
      </div>
      <div>
        <h3>Visit</h3>
        <p>{business.address}<br />{business.city}</p>
        <p><a href={business.phoneHref}>{business.phone}</a><br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
      </div>
      <div>
        <h3>Hours</h3>
        <ul class="plain">{business.hours.map((h) => <li><span>{h.short}</span> {h.open} – {h.close}</li>)}</ul>
      </div>
      <div>
        <h3>Follow</h3>
        <p><a href={business.facebook}>Facebook</a><br /><a href={business.uberEats}>Order on Uber Eats</a></p>
      </div>
    </div>
    <div class="wrap legal">© {new Date().getFullYear()} Polka Deli · Silver Spring, Maryland</div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --red: #c82127;
    --red-dark: #a3181d;
    --ink: #2b2a2a;
    --muted: #5f5b57;
    --cream: #fbf6ef;
    --paper: #ffffff;
    --line: #e9e1d6;
    --radius: 14px;
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: var(--sans); color: var(--ink); background: var(--cream); line-height: 1.6; font-size: 17px; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--red); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.15; margin: 0 0 .5em; }
  .wrap { width: min(1160px, 100% - 32px); margin-inline: auto; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; background: #fff; padding: 8px 12px; z-index: 10; }
  .btn { display: inline-flex; align-items: center; gap: .5em; background: var(--red); color: #fff; text-decoration: none; font-weight: 700; padding: 14px 24px; border-radius: 999px; border: 2px solid var(--red); transition: background .15s; }
  .btn:hover { background: var(--red-dark); border-color: var(--red-dark); }
  .btn-ghost { background: transparent; color: var(--ink); border-color: var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .btn-small { padding: 9px 16px; font-size: 15px; }
  .site-header { background: var(--paper); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
  .header-inner { display: flex; align-items: center; gap: 24px; min-height: 84px; }
  .brand img { width: 190px; }
  .site-header nav { margin-left: auto; }
  .site-header nav ul { display: flex; gap: 24px; list-style: none; margin: 0; padding: 0; }
  .site-header nav a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .site-header nav a:hover { color: var(--red); }
  .site-footer { background: var(--ink); color: #e9e4de; padding: 56px 0 24px; margin-top: 0; }
  .site-footer a { color: #fff; }
  .site-footer h3 { font-family: var(--sans); font-size: 14px; letter-spacing: .08em; text-transform: uppercase; color: #fff; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
  .footer-logo { background: #fff; border-radius: 10px; padding: 8px 12px; margin-bottom: 12px; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain span { display: inline-block; width: 76px; white-space: nowrap; }
  .legal { border-top: 1px solid #4a4747; margin-top: 40px; padding-top: 20px; font-size: 14px; color: #b9b3ac; }
  .mnav { display: none; position: relative; }
  .mnav summary { list-style: none; cursor: pointer; font-weight: 700; border: 2px solid var(--ink); border-radius: 999px; padding: 8px 18px; }
  .mnav summary::-webkit-details-marker { display: none; }
  .mnav ul { position: absolute; right: 0; top: calc(100% + 10px); background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); list-style: none; margin: 0; padding: 8px; min-width: 220px; box-shadow: 0 10px 30px rgba(0,0,0,.08); }
  .mnav a { display: block; padding: 12px 14px; color: var(--ink); text-decoration: none; font-weight: 500; }
  @media (max-width: 900px) {
    .site-header nav, .call { display: none; }
    .mnav { display: block; }
    .header-inner { justify-content: space-between; min-height: 72px; }
    .brand img { width: 150px; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } body { font-size: 16px; } }
</style>
