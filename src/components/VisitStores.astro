---
// "Visit us": deli case photo plus a card per store (address, hours, call button).
import { stores } from '../data/site.js';
import '../styles/visit-stores.css';
import { langOf, hours, tr, ui } from '../i18n.js';
const lang = langOf(Astro.url);
const t = ui[lang];
---
<section class="vs">
  <div class="vs__wrap">
    <h1 class="vs__title">{t.visitUs}</h1>
    <div class="vs__grid">
      <img class="vs__photo" src="/images/media/kielbasa.jpg" alt={t.visitAlt} loading="lazy" />
      {stores.map((s) => (
        <div class="vs__store">
          <h2>{s.city}, {s.locality.split(', ')[1].split(' ')[0]}</h2>
          <p class="vs__addr"><a href={s.maps} target="_blank" rel="noopener">{s.street},<br />{s.locality}</a></p>
          <p class="vs__label">{t.storeHours}</p>
          <table>{s.hours.map(([d, h]) => <tr><td>{tr(lang, d)}</td><td>{hours(lang, h)}</td></tr>)}</table>
          <a class="vs__btn" href={s.phoneHref}>{s.phone}</a>
        </div>
      ))}
    </div>
  </div>
</section>
