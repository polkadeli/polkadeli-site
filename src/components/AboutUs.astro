---
// "About us" block (Maria and Joanna). Used on the home page and on Visit us.
import '../styles/about-us.css';
import { langOf, ui } from '../i18n.js';
const t = ui[langOf(Astro.url)];
---
<section class="au" id="about" aria-labelledby="about-title">
  <div class="au__photo"><img src="/images/media/owners.jpg" alt={t.aboutAlt} loading="lazy" /></div>
  <div class="au__text">
    <h2 id="about-title">{t.aboutHello}</h2>
    <h3>{t.aboutWho[0]}<br class="au__br" />{t.aboutWho[1]}</h3>
    <p>{t.aboutText}</p>
  </div>
</section>
